*~
.DS_Store
__pycache__/
.pytest_cache/
# Hugo build artifacts
public/
resources/_gen/
.hugo_build.lock
.pixi/
# Link-checker cache (lychee.toml sets cache = true)
.lycheecache
# Local mirror of ~/public on the Idiap web server (PDFs and raw images).
# Synced with `pixi run idiap-push` / `pixi run idiap-pull`, never committed.
idiap-public/
# Crossref/ORCID fetch cache
tools/.cache/
# ORCID sync report (regenerated by `pixi run orcid-report`)
orcid-sync-report.md
# The CV: both its input digest and the PDF itself are build products of
# `pixi run cv`. The PDF is the one non-cover file allowed in static/ (see
# tools/validate_content.py) and is published, never committed.
cv/generated.yaml
static/andre-anjos-cv.pdf
# The chart tally, also written by `pixi run cv-data`. It lives under data/ so
# Hugo can read it: the website renders these numbers instead of counting for
# itself, which is what keeps the page and the PDF in agreement.
data/bibliometrics.json
